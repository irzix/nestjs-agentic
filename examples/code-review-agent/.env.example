# ==============================================================================
# Njent Autonomous Code Review Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration (OpenAI, OpenRouter, DeepSeek, vLLM, Ollama)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-or-compatible-api-key

# Optional Custom Base URL (Works with any OpenAI-compatible gateway)
# Examples:
# - OpenRouter: https://openrouter.ai/api/v1
# - DeepSeek:   https://api.deepseek.com/v1
# - vLLM:       http://localhost:8000/v1
# - Ollama:     http://localhost:11434/v1
# - LocalProxy: https://your-custom-proxy.internal/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Primary & Fallback Models
OPENAI_MODEL_NAME=gpt-4o
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. GitHub Integration (GitHub App or Webhook Secret)
# ------------------------------------------------------------------------------
# Secret configured in your GitHub App / Webhook settings for HMAC validation
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# Optional: Personal Access Token (PAT) or GitHub App Token for posting reviews
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# 4. Storage & Persistence (PostgreSQL pgvector & Redis)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for AST Codebase RAG & vector similarity
DATABASE_URL=postgresql://njent_user:njent_password@localhost:5432/njent_db?sslmode=disable

# Redis connection string for Idempotency locks & durable Approval checkpoints
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. Governance & Rate Limiting
# ------------------------------------------------------------------------------
# Sliding window rate limit per PR (max reviews per hour)
RATE_LIMIT_MAX_REQUESTS_PER_PR=5
