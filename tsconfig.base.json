{
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@nestjs-agentic/core": ["./packages/core/dist/index.d.ts"],
      "@nestjs-agentic/core/*": ["./packages/core/dist/*"],
      "@nestjs-agentic/adk": ["./packages/runtime-adk/dist/index.d.ts"],
      "@nestjs-agentic/adk/*": ["./packages/runtime-adk/dist/*"],
      "@nestjs-agentic/memory": ["./packages/memory/dist/index.d.ts"],
      "@nestjs-agentic/memory/*": ["./packages/memory/dist/*"],
      "@nestjs-agentic/experience": ["./packages/experience/dist/index.d.ts"],
      "@nestjs-agentic/experience/*": ["./packages/experience/dist/*"],
      "nestjs-agentic": ["./packages/core/dist/index.d.ts"],
      "nestjs-agentic/*": ["./packages/core/dist/*"]
    }
  }
}
