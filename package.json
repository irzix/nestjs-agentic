{
  "name": "nestjs-agentic-monorepo",
  "version": "0.4.11",
  "private": true,
  "description": "NestJS-native primitives for building production AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irzix/nestjs-agentic.git"
  },
  "bugs": {
    "url": "https://github.com/irzix/nestjs-agentic/issues"
  },
  "homepage": "https://github.com/irzix/nestjs-agentic#readme",
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "dev:agent": "npm run dev --workspace=example-code-review-agent",
    "start:agent": "npm run start:dev --workspace=example-code-review-agent",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build && changeset publish"
  },
  "workspaces": [
    "packages/core",
    "packages/memory",
    "packages/rag",
    "packages/orchestration",
    "packages/evaluation",
    "packages/model-openai",
    "packages/mcp",
    "packages/meta",
    "examples/*",
    "apps/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^26.2.0",
    "openai": "^7.4.0",
    "typescript": "^7.0.2"
  }
}
