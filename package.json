    "packages/runtime-langgraph",
    "packages/meta",
    "examples/*",
    "apps/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
